  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#A7AB9D"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "variable.language",
        "entity.name.tag",
        "support.type.property-name",
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#D1BEE5"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "variable",
        "variable.parameter",
        "variable.other",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#DEDECF"
      }
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#D1BEE5"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator",
        "entity.other.attribute-name",
        "support.function.magic"
      ],
      "settings": {
        "foreground": "#D8C57F"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.fenced_code",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#AECFA3"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "entity.name.type.class",
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#A5CEC1"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.other.color",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#EFB7C2"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "constant.character",
        "constant.character.escape",
        "string.regexp",
        "variable.other.readwrite.alias"
      ],
      "settings": {
        "foreground": "#D7C3A8"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FBA59A"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FBA59A"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#A2C595"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#9BC0DC"
      }
    },
    {
      "scope": [
        "markup.bold",
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#A5CEC1",
    "interface": "#A5CEC1",
    "enum": "#A5CEC1",
    "struct": "#A5CEC1",
    "type": "#A5CEC1",
    "typeParameter": "#A5CEC1",
    "namespace": "#A5CEC1",
    "function": "#D8C57F",
    "method": "#D8C57F",
    "decorator": "#D8C57F",
    "macro": "#D7C3A8",
    "enumMember": "#D7C3A8",
    "variable.readonly": "#D7C3A8",
    "variable.defaultLibrary": "#D7C3A8",
    "parameter": "#DEDECF",
    "property": "#DEDECF",
    "variable": "#DEDECF",
    "keyword": "#D1BEE5",
    "comment": "#A7AB9D",
    "string": "#AECFA3",
    "number": "#EFB7C2",
    "selfParameter": "#D1BEE5",
    "builtinConstant": "#D7C3A8"
  }
}
