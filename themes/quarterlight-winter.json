  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#A1ACA8"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "variable.language",
        "entity.name.tag",
        "support.type.property-name",
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#ABCAE5"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "variable",
        "variable.parameter",
        "variable.other",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#DADFD8"
      }
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#ABCAE5"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator",
        "entity.other.attribute-name",
        "support.function.magic"
      ],
      "settings": {
        "foreground": "#D0C69F"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.fenced_code",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#B2CDB0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "entity.name.type.class",
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#E4BDBC"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.other.color",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#EBBCA3"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "constant.character",
        "constant.character.escape",
        "string.regexp",
        "variable.other.readwrite.alias"
      ],
      "settings": {
        "foreground": "#C9C2E1"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FBA59A"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FBA59A"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#A2C595"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#9BC0DC"
      }
    },
    {
      "scope": [
        "markup.bold",
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#E4BDBC",
    "interface": "#E4BDBC",
    "enum": "#E4BDBC",
    "struct": "#E4BDBC",
    "type": "#E4BDBC",
    "typeParameter": "#E4BDBC",
    "namespace": "#E4BDBC",
    "function": "#D0C69F",
    "method": "#D0C69F",
    "decorator": "#D0C69F",
    "macro": "#C9C2E1",
    "enumMember": "#C9C2E1",
    "variable.readonly": "#C9C2E1",
    "variable.defaultLibrary": "#C9C2E1",
    "parameter": "#DADFD8",
    "property": "#DADFD8",
    "variable": "#DADFD8",
    "keyword": "#ABCAE5",
    "comment": "#A1ACA8",
    "string": "#B2CDB0",
    "number": "#EBBCA3",
    "selfParameter": "#ABCAE5",
    "builtinConstant": "#C9C2E1"
  }
}
